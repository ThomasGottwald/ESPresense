CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
CONFIG_BT_CTRL_BLE_MAX_ACT=4
# We scan with filter_duplicates=0; the controller dedup cache is dead weight.
CONFIG_BT_CTRL_BLE_SCAN_DUPL=n
# Waveshare ESP32-S3-ETH (W5500 over SPI); the S3 has no RMII EMAC.
CONFIG_ETH_SPI_ETHERNET_W5500=y
# sdkconfig.defaults sets DIO, which caused a P0 boot-loop (RTCWDT_RTC_RST) on this
# same board family (see ESP_camwatch/BACKLOG.md item #8). Override to QIO for this board.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
